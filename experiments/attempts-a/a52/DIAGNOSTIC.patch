+            GlweSize(2),
+            P16_MODULUS,
+            CiphertextModulus::new_native(),
+            1u64 << P16_DELTA_LOG,
+            |digit| digit,
+        );
+        for degree in 0..BLIND_ROTATION_MODULUS {
+            let word = actual.get_body().as_ref()[degree % POLYNOMIAL_SIZE];
+            let expected = if degree < POLYNOMIAL_SIZE {
+                word
+            } else {
+                word.wrapping_neg()
+            };
+            assert_eq!(
