[package]
name = "a61_a53_cargo_prototype"
version = "0.1.0"
edition = "2021"

[features]
default = []
a53-fhe = []
diagnostic-trace = ["a53-fhe"]

[dependencies]
tfhe = { version = "0.11", features = ["integer"] }
rayon = "1"
bincode = "1"
dyn-stack = "0.11"
aligned-vec = "0.6"
sha2 = "0.10"

[profile.release]
opt-level = 3

[[bin]]
name = "a61_a53_cargo_prototype"
path = "src/bin/a61_a53_cargo_prototype.rs"
required-features = ["diagnostic-trace"]
