+static bool first_snapshot_line(const char *line, bool *raw_ok) {
+    const char *prefix = "{\"kind\":\"snapshot\",\"seq\":0,";
+    const char *good = "\"raw_ok\":true}", *bad = "\"raw_ok\":false}";
+    size_t n = strlen(line);
+    if (strncmp(line, prefix, strlen(prefix))) return false;
+    const char *flag = strstr(line, "\"raw_ok\":");
+    if (n >= strlen(good) && flag == line + n - strlen(good) && !strcmp(flag, good)) {
+        *raw_ok = true; return true;
+    }
+    if (n >= strlen(bad) && flag == line + n - strlen(bad) && !strcmp(flag, bad)) {
+        *raw_ok = false; return true;
+    }
+    return false;
