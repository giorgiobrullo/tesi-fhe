+    pub selected_below: Option<Lwe>,
+    pub comparison_state_by_level: Vec<Lwe>,
+    pub accept_tag: Option<Lwe>,
+    pub coded_digits_lsb_first: Vec<Lwe>,
+    pub code_groups: Vec<Lwe>,
+    pub final_code: Option<Lwe>,
+}
