+                    "overflow calcolando la norma del template {index}"
+                )
+            }
+            Self::IncorrectTemplateNorm {
+                index,
+                declared,
+                actual,
+            } => write!(
+                formatter,
+                "norma template {index}: dichiarata {declared}, effettiva {actual}"
+            ),
+            Self::DomainDoesNotCoverTemplate {
