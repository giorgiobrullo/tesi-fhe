+                    lwe_ciphertext_add_assign(&mut encoded, zero_candidate);
+                    lwe_ciphertext_opposite_assign(&mut encoded);
+                    lwe_ciphertext_add_assign(&mut encoded, &any_zero);
+                    encoded
+                })
+                .collect()
+        } else {
