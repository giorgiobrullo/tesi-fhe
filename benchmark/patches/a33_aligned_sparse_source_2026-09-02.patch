+fn domain_width(domain: ScoreDomain) -> Result<i64, String> {
+    domain
+        .upper
+        .checked_sub(domain.lower)
+        .and_then(|x| x.checked_add(1))
+        .ok_or_else(|| "larghezza del dominio non rappresentabile".to_string())
+}
