+    fn negacyclic_division_sample(body: &[u64], rotation: usize, degree: usize) -> u64 {
+        let exponent = degree + rotation;
+        let value = body[exponent % body.len()];
+        if (exponent / body.len()).is_multiple_of(2) {
+            value
+        } else {
+            value.wrapping_neg()
+        }
+    }
