+        assert_eq!(
+            plan,
+            PrivateArgminExecutionPlan {
+                cauchy_domain: ScoreDomain {
+                    lower: -987,
+                    upper: 2329,
+                },
+                execution_domain: ScoreDomain {
+                    lower: -1019,
+                    upper: 2329,
+                },
+                aligned_fast_path: true,
+            }
+        );
+        assert!(aligned_uniform_fast_path_for_thresholds(
+            &[4],
