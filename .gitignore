# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Concrete debug dump (scritto quando una compilazione fallisce)
.artifacts/

# Esperimenti in preparazione
wip/

# Output generati dagli esperimenti (si rigenerano da soli: figure, CSV, specifiche macchina)
data/
figures/
datasets/
benchmark/results/_emb_reale.npz
benchmark/results/_crops_reale.npz
status.md
benchmark/results/_emb_reale_extra.npz
.DS_Store
bozza_mail_relatore.md
.mcp/
benchmark/results/_emb_bench_ghost.npz
benchmark/results/_emb_reale_ghost.npz
benchmark/results/_ghost_embed.log
demo/chiavi/

# Materiale FHE generato: la client key e' segreta e nessuna chiave runtime va versionata.
**/chiavi/*.key

# Output di compilazione Cargo
target/
target-*/
target_*/
targets/

# Log grezzi delle esecuzioni
*stdout.log
*stdout.jsonl

# Binari degli esperimenti (bundle.bin da 0,3 GB, secret.bin, input-*.bin): nessun file .bin e' tracciato
*.bin

# Chiavi generate durante le esecuzioni
*.key

# Note di lavoro, dati privati e file generati
/tmp/
/docs/archive/
/docs/research-state/
/docs/personal/
/AGENTS.md
/RESEARCH_BASELINE.md
/attempts.md
/ultimo-meeting-transcription.md
/helib.log
/experiments/14_pipeline_tfhe_rs/results/ritaratura_soglia.txt
.local/
*.npz
*.onnx
*.pt
*.pth
*.pkl

# Esportazioni scientifiche selezionate, dati pubblici inclusi.
/output/*
!/output/figures/
!/output/pdf/
/output/figures/*
!/output/figures/progressione-fhe/
/output/figures/progressione-fhe/*
!/output/figures/progressione-fhe/benchmark-comune-20260909/
!/output/figures/progressione-fhe/benchmark-comune-matplotlib-20260909/
/output/pdf/*
!/output/pdf/progressione-fhe-benchmark-comune-20260909.pdf
!/output/pdf/progressione-fhe-benchmark-comune-matplotlib-20260909.pdf

# Campagne rimisurate dopo la correzione del selettore.
!/output/figures/progressione-fhe/selettori-corretti-20260920/
!/output/figures/ckks-tfhe/
/output/figures/ckks-tfhe/*
!/output/figures/ckks-tfhe/selettore-corretto-20260920/
